# =====================================================================
# Variables de entorno de Voz Cliente (back-end)
# Copie este archivo como docker/.env y complete los valores.
# El archivo .env NUNCA se sube al repositorio (está en .gitignore).
# =====================================================================

# Base de datos local
POSTGRES_PASSWORD=postgres

# Ingreso con Google (HU-01). Proyecto de Google Cloud "VozCliente":
# Google Auth Platform > Clientes > cliente web. Pídale los valores a la Coordinadora de soporte.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secreto de firma del JWT de la sesión: mínimo 32 caracteres aleatorios.
# Genérelo con:  openssl rand -base64 48
JWT_SECRET=

# A dónde vuelve el usuario después de ingresar con Google
APP_FRONTEND_URL=http://localhost:4200

# true solo si la aplicación se sirve por HTTPS (por ejemplo con ngrok)
APP_COOKIE_SEGURA=false
